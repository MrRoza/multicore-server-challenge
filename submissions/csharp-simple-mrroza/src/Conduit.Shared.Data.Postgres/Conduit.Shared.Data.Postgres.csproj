    <OutputType>Library</OutputType>
    <AssemblyName>conduit-shared-data-postgres</AssemblyName>
    <RootNamespace>Conduit.Shared.Data.Postgres</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
